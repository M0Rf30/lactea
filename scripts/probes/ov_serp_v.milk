wave_0_per_point1=n=min(floor(sample*511+0.5),199);
wave_0_per_point2=g=floor(n*0.25);
wave_0_per_point3=m=n-4*g;
wave_0_per_point4=ph=g-8*floor(g*0.125);
wave_0_per_point5=ev=floor(g*0.125);
wave_0_per_point6=ev=ev-5*floor(ev*0.2);
wave_0_per_point7=eps=if(equal(ev,1),0.25,if(equal(ev,2),-0.25,if(equal(ev,3),2,if(equal(ev,4),-2,0))));
wave_0_per_point8=xx=20+6*g+ph*0.125;
wave_0_per_point9=x=if(equal(m,0),xx+5,if(equal(m,3),xx-5+eps,xx))/320;
wave_0_per_point10=y=if(equal(m,1),0.5+80/320,if(equal(m,2),0.5-80/320,0.5));
