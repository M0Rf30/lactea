@@ -0,0 +1,509 @@
+// lactea oracle instrumentation (NOT part of upstream projectM). See FdOracle.hpp.
+#include "FdOracle.hpp"
+
+#include "Renderer/OpenGL.h"
+
+#include <algorithm>
+#include <cmath>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <map>
+#include <set>
+#include <sys/stat.h>
+#include <vector>
+
+namespace libprojectM {
+namespace FdOracle {
+namespace {
+
+struct Config
+{
+    bool enabled{false};
+    uint64_t seed{0};
+    std::string dir;
+    std::set<std::string> stages;
+    bool vars{false};
+    bool textures{false};
+};
+
+const Config& Cfg()
+{
+    static Config cfg = [] {
+        Config c;
+        if (const char* s = std::getenv("FD_SEED"); s && *s)
+        {
+            c.enabled = true;
+            c.seed = std::strtoull(s, nullptr, 10);
+        }
+        if (const char* d = std::getenv("FD_DUMP_DIR"); d && *d)
+        {
+            c.dir = d;
+        }
+        if (const char* st = std::getenv("FD_DUMP_STAGES"); st && *st)
+        {
+            std::string all = st;
+            size_t pos = 0;
+            while (pos <= all.size())
+            {
+                auto next = all.find(',', pos);
+                if (next == std::string::npos)
+                {
+                    next = all.size();
+                }
+                if (next > pos)
+                {
+                    c.stages.insert(all.substr(pos, next - pos));
+                }
+                pos = next + 1;
+            }
+        }
+        if (const char* v = std::getenv("FD_DUMP_VARS"); v && *v && *v != '0')
+        {
+            c.vars = true;
+        }
+        if (const char* t = std::getenv("FD_DUMP_TEXTURES"); t && *t && *t != '0')
+        {
+            c.textures = true;
+        }
+        return c;
+    }();
+    return cfg;
+}
+
+uint64_t SplitMixMix(uint64_t z)
+{
+    z = (z ^ (z >> 30)) * 0xBF58476D1CE4E5B9ULL;
+    z = (z ^ (z >> 27)) * 0x94D049BB133111EBULL;
+    return z ^ (z >> 31);
+}
+
+uint64_t Fnv1a64(const std::string& s)
+{
+    uint64_t h = 0xCBF29CE484222325ULL;
+    for (unsigned char c : s)
+    {
+        h ^= c;
+        h *= 0x100000001B3ULL;
+    }
+    return h;
+}
+
+using ImageSink = void (*)(const char* name, int frame, int width, int height, const uint8_t* rgba, void* user);
+ImageSink g_sink{nullptr};
+void* g_sinkUser{nullptr};
+
+std::map<std::string, double>& Vars()
+{
+    static std::map<std::string, double> v;
+    return v;
+}
+
+std::vector<std::string>& ShaderErrors()
+{
+    static std::vector<std::string> e;
+    return e;
+}
+
+std::map<std::string, std::string>& Info()
+{
+    static std::map<std::string, std::string> i;
+    return i;
+}
+
+void MkDirs(const std::string& path)
+{
+    std::string cur;
+    for (size_t i = 0; i <= path.size(); i++)
+    {
+        if (i == path.size() || path[i] == '/')
+        {
+            if (!cur.empty())
+            {
+                mkdir(cur.c_str(), 0777);
+            }
+        }
+        if (i < path.size())
+        {
+            cur.push_back(path[i]);
+        }
+    }
+}
+
+std::string JsonEscape(const std::string& s)
+{
+    std::string o;
+    for (unsigned char c : s)
+    {
+        switch (c)
+        {
+            case '"': o += "\\\""; break;
+            case '\\': o += "\\\\"; break;
+            case '\n': o += "\\n"; break;
+            case '\r': o += "\\r"; break;
+            case '\t': o += "\\t"; break;
+            default:
+                if (c < 0x20)
+                {
+                    char b[8];
+                    std::snprintf(b, sizeof b, "\\u%04x", c);
+                    o += b;
+                }
+                else
+                {
+                    o.push_back(static_cast<char>(c));
+                }
+        }
+    }
+    return o;
+}
+
+std::string FormatNumber(double v)
+{
+    if (std::isnan(v))
+    {
+        return "\"nan\"";
+    }
+    if (std::isinf(v))
+    {
+        return v > 0 ? "\"inf\"" : "\"-inf\"";
+    }
+    char buf[40];
+    std::snprintf(buf, sizeof buf, "%.17g", v);
+    return buf;
+}
+
+} // namespace
+
+namespace { int g_frame = 0; const char* g_stagePrefix = ""; }
+void SetStagePrefix(const char* prefix) { g_stagePrefix = prefix ? prefix : ""; }
+int CurrentFrame() { return g_frame; }
+void SetCurrentFrame(int frame) { g_frame = frame; }
+bool Enabled() { return Cfg().enabled; }
+uint64_t Seed() { return Cfg().seed; }
+
+Rng::Rng(const std::string& streamName)
+    : m_state(SplitMixMix(Cfg().seed + 0x9E3779B97F4A7C15ULL) ^ Fnv1a64(streamName))
+{
+}
+
+uint64_t Rng::Next64()
+{
+    m_state += 0x9E3779B97F4A7C15ULL;
+    return SplitMixMix(m_state);
+}
+
+size_t TransitionShaderIndex(size_t count)
+{
+    static Rng select("transition_select");
+    const uint32_t r = select.Next32();
+    if (count == 0)
+    {
+        return 0;
+    }
+    size_t index = r % count;
+    if (Cfg().enabled)
+    {
+        if (const char* f = std::getenv("FD_TRANSITION_SHADER"); f && *f)
+        {
+            index = static_cast<size_t>(std::strtoul(f, nullptr, 10)) % count;
+        }
+    }
+    return index;
+}
+
+void TransitionStatic(int32_t out[4])
+{
+    static Rng stat("transition_static");
+    for (int i = 0; i < 4; i++)
+    {
+        out[i] = static_cast<int32_t>(stat.Next32());
+    }
+    if (Cfg().enabled)
+    {
+        if (const char* f = std::getenv("FD_TRANSITION_STATIC"); f && *f)
+        {
+            long long v[4];
+            if (std::sscanf(f, "%lld,%lld,%lld,%lld", &v[0], &v[1], &v[2], &v[3]) == 4)
+            {
+                for (int i = 0; i < 4; i++)
+                {
+                    out[i] = static_cast<int32_t>(v[i]);
+                }
+            }
+        }
+    }
+}
+
+bool DumpActive() { return Cfg().enabled && (!Cfg().stages.empty() || Cfg().vars || Cfg().textures); }
+bool StageWanted(const char* stage)
+{
+    const auto& s = Cfg().stages;
+    return Cfg().enabled && (s.count("all") != 0 || s.count(stage) != 0);
+}
+bool VarsWanted() { return Cfg().enabled && Cfg().vars && !Cfg().dir.empty(); }
+bool TexturesWanted() { return Cfg().enabled && Cfg().textures; }
+bool ForceBlur()
+{
+    return StageWanted("blur1") || StageWanted("blur2") || StageWanted("blur3");
+}
+
+GlStateGuard::GlStateGuard()
+{
+    GLint v{};
+    glGetIntegerv(GL_READ_FRAMEBUFFER_BINDING, &v);
+    m_readFbo = v;
+    glGetIntegerv(GL_DRAW_FRAMEBUFFER_BINDING, &v);
+    m_drawFbo = v;
+    glGetIntegerv(GL_VIEWPORT, m_viewport);
+    m_blend = glIsEnabled(GL_BLEND);
+    glGetIntegerv(GL_BLEND_SRC_RGB, &v);
+    m_blendSrcRgb = v;
+    glGetIntegerv(GL_BLEND_DST_RGB, &v);
+    m_blendDstRgb = v;
+    glGetIntegerv(GL_BLEND_SRC_ALPHA, &v);
+    m_blendSrcAlpha = v;
+    glGetIntegerv(GL_BLEND_DST_ALPHA, &v);
+    m_blendDstAlpha = v;
+    glGetIntegerv(GL_BLEND_EQUATION_RGB, &v);
+    m_blendEqRgb = v;
+    glGetIntegerv(GL_BLEND_EQUATION_ALPHA, &v);
+    m_blendEqAlpha = v;
+    glGetIntegerv(GL_ACTIVE_TEXTURE, &v);
+    m_activeTexture = v;
+    glActiveTexture(GL_TEXTURE0);
+    glGetIntegerv(GL_TEXTURE_BINDING_2D, &v);
+    m_tex2dUnit0 = v;
+    glGetIntegerv(GL_SAMPLER_BINDING, &v);
+    m_samplerUnit0 = v;
+    glActiveTexture(static_cast<GLenum>(m_activeTexture));
+    glGetIntegerv(GL_CURRENT_PROGRAM, &v);
+    m_program = v;
+    glGetIntegerv(GL_VERTEX_ARRAY_BINDING, &v);
+    m_vao = v;
+    glGetIntegerv(GL_ARRAY_BUFFER_BINDING, &v);
+    m_arrayBuffer = v;
+}
+
+GlStateGuard::~GlStateGuard()
+{
+    glBindFramebuffer(GL_READ_FRAMEBUFFER, static_cast<GLuint>(m_readFbo));
+    glBindFramebuffer(GL_DRAW_FRAMEBUFFER, static_cast<GLuint>(m_drawFbo));
+    glViewport(m_viewport[0], m_viewport[1], m_viewport[2], m_viewport[3]);
+    if (m_blend)
+    {
+        glEnable(GL_BLEND);
+    }
+    else
+    {
+        glDisable(GL_BLEND);
+    }
+    glBlendFuncSeparate(static_cast<GLenum>(m_blendSrcRgb), static_cast<GLenum>(m_blendDstRgb),
+                        static_cast<GLenum>(m_blendSrcAlpha), static_cast<GLenum>(m_blendDstAlpha));
+    glBlendEquationSeparate(static_cast<GLenum>(m_blendEqRgb), static_cast<GLenum>(m_blendEqAlpha));
+    glActiveTexture(GL_TEXTURE0);
+    glBindTexture(GL_TEXTURE_2D, static_cast<GLuint>(m_tex2dUnit0));
+    glBindSampler(0, static_cast<GLuint>(m_samplerUnit0));
+    glActiveTexture(static_cast<GLenum>(m_activeTexture));
+    glUseProgram(static_cast<GLuint>(m_program));
+    glBindVertexArray(static_cast<GLuint>(m_vao));
+    glBindBuffer(GL_ARRAY_BUFFER, static_cast<GLuint>(m_arrayBuffer));
+}
+
+void DumpTexture2D(const char* stage, int frame, unsigned int textureId, int width, int height, bool flipRows)
+{
+    if (!g_sink || width <= 0 || height <= 0 || textureId == 0)
+    {
+        return;
+    }
+
+    GLint prevTex{};
+    GLint prevAlign{};
+    GLint prevPackBuf{};
+    glGetIntegerv(GL_TEXTURE_BINDING_2D, &prevTex);
+    glGetIntegerv(GL_PACK_ALIGNMENT, &prevAlign);
+    glGetIntegerv(GL_PIXEL_PACK_BUFFER_BINDING, &prevPackBuf);
+    glBindBuffer(GL_PIXEL_PACK_BUFFER, 0);
+    glPixelStorei(GL_PACK_ALIGNMENT, 1);
+    glBindTexture(GL_TEXTURE_2D, textureId);
+
+    std::vector<uint8_t> raw(static_cast<size_t>(width) * height * 4);
+    glGetTexImage(GL_TEXTURE_2D, 0, GL_RGBA, GL_UNSIGNED_BYTE, raw.data());
+
+    glBindTexture(GL_TEXTURE_2D, static_cast<GLuint>(prevTex));
+    glPixelStorei(GL_PACK_ALIGNMENT, prevAlign);
+    glBindBuffer(GL_PIXEL_PACK_BUFFER, static_cast<GLuint>(prevPackBuf));
+
+    if (flipRows)
+    {
+        std::vector<uint8_t> out(raw.size());
+        const size_t stride = static_cast<size_t>(width) * 4;
+        for (int y = 0; y < height; y++)
+        {
+            std::memcpy(out.data() + static_cast<size_t>(y) * stride,
+                        raw.data() + static_cast<size_t>(height - 1 - y) * stride, stride);
+        }
+        raw.swap(out);
+    }
+
+    const std::string outName = std::string(g_stagePrefix) + stage;
+    g_sink(outName.c_str(), frame, width, height, raw.data(), g_sinkUser);
+
+    if (frame == 0 && std::strncmp(stage, "blur", 4) == 0)
+    {
+        NoteInfo(std::string(stage) + "_size", "[" + std::to_string(width) + "," + std::to_string(height) + "]");
+    }
+}
+
+void DumpStaticTexture(const char* name, unsigned int textureId, unsigned int target, int width, int height, int depth)
+{
+    if (!TexturesWanted() || textureId == 0)
+    {
+        return;
+    }
+
+    GLint prevTex{};
+    GLint prevAlign{};
+    glGetIntegerv(target == GL_TEXTURE_3D ? GL_TEXTURE_BINDING_3D : GL_TEXTURE_BINDING_2D, &prevTex);
+    glGetIntegerv(GL_PACK_ALIGNMENT, &prevAlign);
+    glPixelStorei(GL_PACK_ALIGNMENT, 1);
+    glBindTexture(target, textureId);
+
+    std::vector<uint8_t> raw(static_cast<size_t>(width) * height * depth * 4);
+    glGetTexImage(target, 0, GL_RGBA, GL_UNSIGNED_BYTE, raw.data());
+
+    glBindTexture(target, static_cast<GLuint>(prevTex));
+    glPixelStorei(GL_PACK_ALIGNMENT, prevAlign);
+
+    if (target == GL_TEXTURE_3D)
+    {
+        if (Cfg().dir.empty())
+        {
+            return;
+        }
+        MkDirs(Cfg().dir + "/textures");
+        std::string path = Cfg().dir + "/textures/" + name + ".bin";
+        if (FILE* f = std::fopen(path.c_str(), "wb"))
+        {
+            // "FDV3" | u32 version=1 | u32 width | u32 height | u32 depth | u32 channels=4 | u32 format=0 (RGBA8)
+            // then width*height*depth*4 bytes: x fastest, then y, then z; byte order R,G,B,A.
+            const uint32_t hdr[6] = {0x33564446u /* "FDV3" LE */, 1u, static_cast<uint32_t>(width),
+                                     static_cast<uint32_t>(height), static_cast<uint32_t>(depth), 4u};
+            const uint32_t format = 0;
+            std::fwrite(hdr, sizeof hdr, 1, f);
+            std::fwrite(&format, sizeof format, 1, f);
+            std::fwrite(raw.data(), 1, raw.size(), f);
+            std::fclose(f);
+        }
+    }
+    else if (g_sink)
+    {
+        g_sink((std::string("textures/") + name).c_str(), -1, width, height, raw.data(), g_sinkUser);
+    }
+}
+
+void SetVar(const std::string& name, double value)
+{
+    if (VarsWanted())
+    {
+        Vars()[name] = value;
+    }
+}
+
+void FlushVars(int frame)
+{
+    if (!VarsWanted())
+    {
+        return;
+    }
+    auto& vars = Vars();
+
+    // Unprefixed rand_frame/rand_preset = composite shader's values if it exists, else the warp shader's.
+    for (const char* base : {"rand_frame", "rand_preset"})
+    {
+        for (const char* c : {"x", "y", "z", "w"})
+        {
+            const std::string suffix = std::string(base) + "." + c;
+            auto it = vars.find("comp." + suffix);
+            if (it == vars.end())
+            {
+                it = vars.find("warp." + suffix);
+            }
+            if (it != vars.end())
+            {
+                vars[suffix] = it->second;
+            }
+        }
+    }
+
+    MkDirs(Cfg().dir + "/" + g_stagePrefix + "vars");
+    char name[64];
+    std::snprintf(name, sizeof name, "/%svars/%05d.json", g_stagePrefix, frame);
+    if (FILE* f = std::fopen((Cfg().dir + name).c_str(), "wb"))
+    {
+        std::fputs("{", f);
+        bool first = true;
+        for (const auto& [k, v] : vars)
+        {
+            std::fprintf(f, "%s\n\"%s\": %s", first ? "" : ",", JsonEscape(k).c_str(), FormatNumber(v).c_str());
+            first = false;
+        }
+        std::fputs("\n}\n", f);
+        std::fclose(f);
+    }
+    vars.clear();
+}
+
+void RecordShaderError(const std::string& message)
+{
+    ShaderErrors().push_back(message);
+}
+
+void NoteInfo(const std::string& key, const std::string& jsonValue)
+{
+    Info()[key] = jsonValue;
+}
+
+} // namespace FdOracle
+} // namespace libprojectM
+
+// ---- C API for the refrender harness (not part of the public projectM API) ---------------------
+extern "C" {
+
+__attribute__((visibility("default"))) void fd_oracle_set_image_sink(
+    void (*sink)(const char* name, int frame, int width, int height, const uint8_t* rgba, void* user), void* user)
+{
+    libprojectM::FdOracle::g_sink = sink;
+    libprojectM::FdOracle::g_sinkUser = user;
+}
+
+/// Returns a JSON object: {"shader_errors": N, "shader_error_messages": [...], <info keys...>}.
+/// The pointer stays valid until the next call.
+__attribute__((visibility("default"))) const char* fd_oracle_info_json()
+{
+    using namespace libprojectM::FdOracle;
+    static std::string out;
+    out = "{\"shader_errors\": " + std::to_string(ShaderErrors().size()) + ", \"shader_error_messages\": [";
+    for (size_t i = 0; i < ShaderErrors().size(); i++)
+    {
+        out += (i ? ", \"" : "\"") + JsonEscape(ShaderErrors()[i]) + "\"";
+    }
+    out += "]";
+    for (const auto& [k, v] : Info())
+    {
+        out += ", \"" + JsonEscape(k) + "\": " + v;
+    }
+    out += "}";
+    return out.c_str();
+}
+
+__attribute__((visibility("default"))) void fd_oracle_reset_errors()
+{
+    libprojectM::FdOracle::ShaderErrors().clear();
+}
+
+__attribute__((visibility("default"))) int fd_oracle_shader_error_count()
+{
+    return static_cast<int>(libprojectM::FdOracle::ShaderErrors().size());
+}
+}
diff --git a/src/libprojectM/FdOracle.hpp b/src/libprojectM/FdOracle.hpp
new file mode 100644
index 0000000..dfdfcfc
--- /dev/null
+++ b/src/libprojectM/FdOracle.hpp
@@ -0,0 +1,94 @@
+// lactea oracle instrumentation (NOT part of upstream projectM).
+// Everything here is inert unless the FD_* environment variables are set; see oracle/README.md.
+#pragma once
+
+#include <cstdint>
+#include <string>
+
+namespace libprojectM {
+namespace FdOracle {
+
+/// True when FD_SEED is set: all RNGs are replaced by the documented deterministic streams.
+bool Enabled();
+/// Frame index set by the preset before drawing the frame (used by deep hooks like the blur pass).
+int CurrentFrame();
+void SetCurrentFrame(int frame);
+uint64_t Seed();
+
+/// Deterministic stream: state = splitmix64(seed) ^ fnv1a64(name); next64() = splitmix64 step.
+class Rng
+{
+public:
+    explicit Rng(const std::string& streamName);
+    uint64_t Next64();
+    uint32_t Next32() { return static_cast<uint32_t>(Next64() >> 32); }
+
+private:
+    uint64_t m_state;
+};
+
+/// Drop-in for "std::uniform_int_distribution<int>(0, INT32_MAX)(engine)": returns Next32() >> 1.
+inline int RandInt31(Rng& rng) { return static_cast<int>(rng.Next32() >> 1); }
+
+/// Replacement for the projectM shader `rand() % 7381 / 7380.0f` helper.
+inline float ShaderFloat(Rng& rng) { return static_cast<float>(rng.Next32() % 7381u) / 7380.0f; }
+
+// ---- dumping -----------------------------------------------------------------------------
+bool DumpActive();               ///< Any stage/vars/textures output requested.
+bool StageWanted(const char* stage);
+bool VarsWanted();
+bool TexturesWanted();
+bool ForceBlur();                ///< Compute all three blur levels even if no shader uses them.
+
+/// RAII snapshot/restore of every piece of GL state `BlurTexture::Update` touches (FBO read/draw bindings, viewport, blend
+/// enable/function/equation, active texture + unit-0 2D texture and sampler bindings, program, VAO, array buffer). Used
+/// only when the blur chain runs *solely* because blur dumps were requested (no shader samples blur), so that dumping the
+/// blur textures cannot change what is rendered. Natively-needed blur updates are left exactly as upstream has them.
+class GlStateGuard
+{
+public:
+    GlStateGuard();
+    ~GlStateGuard();
+    GlStateGuard(const GlStateGuard&) = delete;
+    GlStateGuard& operator=(const GlStateGuard&) = delete;
+
+private:
+    int m_readFbo{}, m_drawFbo{};
+    int m_viewport[4]{};
+    unsigned char m_blend{};
+    int m_blendSrcRgb{}, m_blendDstRgb{}, m_blendSrcAlpha{}, m_blendDstAlpha{}, m_blendEqRgb{}, m_blendEqAlpha{};
+    int m_activeTexture{};
+    int m_tex2dUnit0{};
+    int m_samplerUnit0{};
+    int m_program{};
+    int m_vao{};
+    int m_arrayBuffer{};
+};
+
+/// Read back a 2D RGBA8 texture and hand it to the image sink as top-down rows.
+/// `glRowsBottomFirst` = true if the GL storage has row 0 at the bottom of the image (needs a flip).
+void DumpTexture2D(const char* stage, int frame, unsigned int textureId, int width, int height, bool flipRows);
+/// Static texture (2D -> PNG through the sink, rows in GL memory order; 3D -> .bin file).
+void DumpStaticTexture(const char* name, unsigned int textureId, unsigned int target, int width, int height, int depth);
+
+void SetVar(const std::string& name, double value);
+void FlushVars(int frame);
+
+void RecordShaderError(const std::string& message);
+void NoteInfo(const std::string& key, const std::string& jsonValue);
+
+// ---- preset transitions ---------------------------------------------------------------------
+/// Prefix prepended to the output name/dir of per-preset dumps (stage dirs and vars dir). `ProjectM::RenderFrame` sets
+/// "new_" around the incoming preset's frame; StageWanted keeps checking the plain stage name.
+void SetStagePrefix(const char* prefix);
+
+/// Soft-cut shader choice: "transition_select" stream Next32() % count (one persistent stream, advanced exactly once per
+/// call). `FD_TRANSITION_SHADER=k` forces the result (the stream still advances). Only meaningful when Enabled().
+size_t TransitionShaderIndex(size_t count);
+
+/// The 4 `iRandStatic` ints: 4 x static_cast<int32_t>(Next32()) of the persistent "transition_static" stream.
+/// `FD_TRANSITION_STATIC=a,b,c,d` overrides the values (the stream still advances 4 times).
+void TransitionStatic(int32_t out[4]);
+
+} // namespace FdOracle
+} // namespace libprojectM
